{
  "name": "be-crm-management",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "mocha",
    "test:unit": "mocha --config .mocharc.unit.cjs",
    "test:integration": "mocha 'src/tests/integration/**/*.test.ts'",
    "test:coverage": "c8 mocha",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose --profile tools stop",
    "db:start": "docker compose start",
    "db:restart": "docker compose --profile tools restart",
    "db:down": "docker compose --profile tools down",
    "db:tools": "docker compose --profile tools up -d",
    "dev": "concurrently -n api,worker -c blue,magenta \"tsx watch src/index.ts\" \"tsx watch src/workers/index.ts\"",
    "typecheck": "tsc --noEmit",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "bash scripts/new-migration.sh",
    "migration:run": "npm run typeorm -- migration:run -d ./src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/data-source.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "tsx src/db/seed.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "Harshit Raizada",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@types/mailparser": "^3.4.6",
    "axios": "^1.18.1",
    "bullmq": "^5.79.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "imapflow": "^1.6.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.8",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "mocha": "^11.7.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
